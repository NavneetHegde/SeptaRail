<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeptaRail.ClientApp.Views.Pages.AboutPage"
             Title="About">
    <Grid RowDefinitions="250,*" BackgroundColor="#84BDE8" RowSpacing="15" Padding="10,10,10,10">
        <Border StrokeThickness="0" BackgroundColor="#327ECC" StrokeShape="RoundRectangle 25">
            <Border.Shadow>
                <Shadow Radius="35" Opacity="0" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="22" Margin="25,25,25,5">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="dotnet_bot.png" SemanticProperties.Description="Seprr" HeightRequest="64" />
                    <Label FontSize="22" TextColor="White" FontAttributes="Bold" Text="Seprr" VerticalOptions="End" />
                    <Label FontSize="22" TextColor="White" Text="1.0.0-alpha" VerticalOptions="End" />
                </HorizontalStackLayout>
                <Label TextColor="White" Text="Updates Septa regional rail user of next three trains arriving from specific source to destination." />
                <Button BackgroundColor="White" Text="Learn more..."/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>